<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ouvrir un socket d'écoute local + lire l'IP Wi-Fi pour l'afficher. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      V0.5 — SMS réels. Permissions dangereuses (Android 6+) : demande runtime
      explicite dans MainActivity, révocables à tout moment. Si elles sont
      refusées, le serveur retombe sur les données de démo (DemoData) et
      /v1/health renvoie sms_permission=false. READ_CONTACTS est optionnelle :
      sert uniquement à résoudre numéro → nom de contact.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      V0.7 — Foreground Service hébergeant le serveur HTTP NanoHTTPD pour qu'il
      survive à la fermeture/mise en arrière-plan de l'activité.
      FOREGROUND_SERVICE_DATA_SYNC : type requis depuis Android 14 (API 34) ;
      le serveur synchronise SMS/MMS/RCS vers le client Ubuntu.
      POST_NOTIFICATIONS : requis depuis Android 13 (API 33) pour afficher la
      notification persistante du service (demandée au runtime).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneLinkCompanion"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          V0.7 — Service de premier plan hébergeant CompanionServer (NanoHTTPD).
          Le type data_sync correspond à la synchronisation SMS/MMS/RCS vers le
          client Ubuntu. Non exporté : piloté uniquement par l'application.
        -->
        <service
            android:name=".CompanionForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          V0.6 — Accès aux notifications pour capter les messages RCS de Google
          Messages (lecture seule). Lié par le système : requiert la permission
          BIND_NOTIFICATION_LISTENER_SERVICE et l'autorisation explicite de
          l'utilisateur (Réglages → Accès aux notifications).
        -->
        <service
            android:name=".RcsNotificationListener"
            android:label="@string/rcs_listener_label"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
